# Server
NODE_ENV=development
PORT=5000

# Database
# DATABASE_URL="postgresql://rekaz_admin:password@localhost:5432/rekaz_petroleum?schema=public"
DATABASE_URL="postgresql://postgres:admin@localhost:5432/rekaz_petroleum?schema=public"
# Redis (Docker maps container 6379 -> host 6380)
# DATABASE_URL="postgresql://postgres:admin@localhost:5432/rekaz_petroleum?schema=public"
REDIS_URL=redis://localhost:6380
REDIS_PASSWORD=

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_REFRESH_SECRET="your-refresh-secret-change-this"
JWT_EXPIRY="7d"
JWT_REFRESH_EXPIRY="30d"

# Email (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Logging
LOG_LEVEL="info"
LOG_FILE="logs/app.log"

# Rate Limiting
RATE_LIMIT_WINDOW=900000  # 15 minutes
RATE_LIMIT_MAX=100